# ===============================================
# PostgreSQL Database Configuration (VPS)
# ===============================================
DATABASE_TYPE=postgresql
DATABASE_HOST=your-vps-ip-or-domain
DATABASE_PORT=5432
DATABASE_NAME=hr_recruitment
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password

# Direct Connection URL
DATABASE_URL=postgresql://postgres:your_secure_password@your-vps-ip-or-domain:5432/hr_recruitment

# ===============================================
# Server & API Configuration
# ===============================================
PORT=3000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key

# ===============================================
# AI Provider API Keys
# ===============================================
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
